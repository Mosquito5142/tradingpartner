# Turso (libSQL) — คลังสถิติ Reaction Lab
# สร้างฟรีที่ https://turso.tech  ->  turso db create goldnews
#   turso db show goldnews --url
#   turso db tokens create goldnews
TURSO_DATABASE_URL=libsql://xxxx.turso.io
TURSO_AUTH_TOKEN=

# กันคนอื่นเรียก /api/collect (Vercel Cron ส่ง header นี้ให้อัตโนมัติ)
CRON_SECRET=

# ราคาที่กราฟโบรกเกอร์แสดง ลบด้วย ราคา spot ที่หน้าเว็บแสดง
BROKER_OFFSET=-3.04

# แจ้งเตือน Telegram ก่อนข่าวใหญ่ 30 นาที (ไม่ตั้งก็ใช้ส่วนอื่นได้ปกติ)
# token จาก @BotFather · chat id จาก https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
